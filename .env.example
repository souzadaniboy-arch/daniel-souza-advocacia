# ============================================================
# VARIÁVEIS DE AMBIENTE — Daniel de Souza Advocacia
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o arquivo .env real.
# ============================================================

# Base de dados
# Para desenvolvimento local, utilize SQLite (valor abaixo).
# Para produção (cPanel/MySQL), altere para:
# DATABASE_URL="mysql://usuario:senha@host:3306/nome_banco"
# Para produção (PostgreSQL):
# DATABASE_URL="postgresql://usuario:senha@host:5432/nome_banco?schema=public"
DATABASE_URL="file:./dev.db"

# URL pública do site (sem barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Segredo para assinatura dos tokens de sessão (JWT).
# Gere com: openssl rand -base64 32
AUTH_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_BYTES"

# E-mail de destino dos formulários de contato
CONTACT_EMAIL="[INSERIR E-MAIL]"

# Proteção de formulários (anti-spam via honeypot). Pode ficar habilitado.
# Se desejar reCAPTCHA futuro, adicione:
# RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
